# Required
DISCORD_TOKEN=
OPENROUTER_API_KEY=

# Optional
GUILD_ID=
PORT=8080
LOG_LEVEL=info

# Persona identity. BOT_NAME fills {{bot}} in the prompt and about text.
BOT_NAME=Keyholder
# Optional. Leave empty to let any member talk to the persona.
LOCKEE_ROLE_ID=
# Seeds SOUL.md on first boot. The live SOUL on the volume wins afterwards.
SYSTEM_PROMPT_FILE=./prompts/keyholder.md
# SYSTEM_PROMPT=
# Served by /about. A missing file falls back to one in-character line.
ABOUT_FILE=./prompts/about.md
CONTEXT_MESSAGES=15
MAX_CHUNKS=3
TIMEOUT_SECONDS=60
MAX_CONCURRENT=2
RATE_LIMIT_CAPACITY=2
RATE_LIMIT_SECONDS=10

# The persona reads Discord image attachments on the current message and on the
# message it replies to. Detail is auto, low, high, or original.
VISION_ENABLED=true
VISION_MAX_IMAGES=4
VISION_MAX_IMAGE_MB=8
VISION_DETAIL=auto

# Persistent memory and the live SOUL. /learn edits SOUL.md here without a
# deployment. On Railway this is the mounted volume.
MEMORY_ENABLED=true
MEMORY_DIR=./data
MEMORY_MAX_CHARS=3000
MEMORY_CONTEXT_MAX_CHARS=2500
MEMORY_TIMEOUT_SECONDS=30
SOUL_MAX_CHARS=8000
LEARNING_SESSION_MINUTES=60
LEARNING_TIMEOUT_SECONDS=60
# AUX_MODEL=
AUX_MAX_TOKENS=4096

# Punishment adds this percent of the remaining timed lock, clamped in minutes.
PUNISH_PERCENT=5
PUNISH_MIN_MINUTES=30
PUNISH_MAX_MINUTES=240

OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash-1017
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Read-only ChastiSafe status for the keyholder persona. The developer code is
# a password: keep it in the environment, never in git.
CHASTITY_ENABLED=true
CHASTISAFE_KEYHOLDER_CODE=

# Shared ChastiSafe API root. Leave empty for the default.
# CHASTISAFE_BASE_URL=https://chastisafe.com/api-v1
